{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/ocr_pipeline/document_model.schema.json",
  "title": "CanonicalDocumentModel",
  "type": "object",
  "required": [
    "schema_version",
    "document_id",
    "pages",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Page"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "BBox": {
      "type": [
        "array",
        "null"
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "Word": {
      "type": "object",
      "required": [
        "word_id",
        "text",
        "bbox",
        "confidence",
        "reading_order"
      ],
      "properties": {
        "word_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "reading_order": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "Line": {
      "type": "object",
      "required": [
        "line_id",
        "block_id",
        "page_id",
        "text",
        "bbox",
        "confidence",
        "reading_order",
        "source_engine",
        "provenance",
        "words"
      ],
      "properties": {
        "line_id": {
          "type": "string"
        },
        "block_id": {
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "reading_order": {
          "type": "integer"
        },
        "source_engine": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Word"
          }
        }
      },
      "additionalProperties": true
    },
    "Block": {
      "type": "object",
      "required": [
        "block_id",
        "page_id",
        "block_type",
        "bbox",
        "text",
        "confidence",
        "reading_order",
        "source_engine",
        "provenance"
      ],
      "properties": {
        "block_id": {
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "block_type": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "reading_order": {
          "type": "integer"
        },
        "source_engine": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Line"
          }
        }
      },
      "additionalProperties": true
    },
    "TableCell": {
      "type": "object",
      "required": [
        "cell_id",
        "row_index",
        "column_index",
        "row_span",
        "column_span",
        "bbox",
        "text",
        "confidence",
        "reading_order"
      ],
      "properties": {
        "cell_id": {
          "type": "string"
        },
        "row_index": {
          "type": "integer"
        },
        "column_index": {
          "type": "integer"
        },
        "row_span": {
          "type": "integer"
        },
        "column_span": {
          "type": "integer"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "reading_order": {
          "type": "integer"
        }
      },
      "additionalProperties": true
    },
    "Table": {
      "type": "object",
      "required": [
        "table_id",
        "page_id",
        "bbox",
        "rows",
        "columns",
        "cells",
        "text",
        "confidence"
      ],
      "properties": {
        "table_id": {
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "rows": {
          "type": "integer"
        },
        "columns": {
          "type": "integer"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableCell"
          }
        },
        "text": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "KeyValue": {
      "type": "object",
      "required": [
        "key_text",
        "value_text",
        "key_bbox",
        "value_bbox",
        "confidence",
        "source"
      ],
      "properties": {
        "key_text": {
          "type": "string"
        },
        "value_text": {
          "type": "string"
        },
        "key_bbox": {
          "$ref": "#/$defs/BBox"
        },
        "value_bbox": {
          "$ref": "#/$defs/BBox"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "Figure": {
      "type": "object",
      "required": [
        "figure_id",
        "page_id",
        "bbox",
        "caption",
        "confidence",
        "source_engine"
      ],
      "properties": {
        "figure_id": {
          "type": "string"
        },
        "page_id": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "caption": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_engine": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "Page": {
      "type": "object",
      "required": [
        "page_id",
        "dimensions",
        "blocks",
        "tables",
        "key_value_pairs",
        "figures",
        "raw_ocr_text",
        "reading_order_text",
        "markdown_output",
        "structured_json_output",
        "provenance"
      ],
      "properties": {
        "page_id": {
          "type": "string"
        },
        "page_number": {
          "type": "integer"
        },
        "dimensions": {
          "type": "object",
          "required": [
            "width",
            "height",
            "unit"
          ],
          "properties": {
            "width": {
              "type": [
                "number",
                "null"
              ]
            },
            "height": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "raw_ocr_text": {
          "type": "string"
        },
        "reading_order_text": {
          "type": "string"
        },
        "markdown_output": {
          "type": "string"
        },
        "structured_json_output": {
          "type": "object",
          "additionalProperties": true
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Block"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Table"
          }
        },
        "key_value_pairs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/KeyValue"
          }
        },
        "figures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Figure"
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
